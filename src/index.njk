---
layout: base.njk
description: "Landscape photography by Michael Robinson. Rainforest and waterfalls of the Scenic Rim, dawn and dusk over big country, and quiet water across Australia."
---
{#- Picks 3 varied hero works (collection 0/2/1, work 0/1/1) without assuming
    that many collections or works actually exist — wraps via modulo so a
    smaller portfolio degrades gracefully instead of crashing the build. -#}
{%- set heroPicks = [[0, 0], [2, 1], [1, 1]] -%}
{%- set heroes = [] -%}
{%- for pick in heroPicks -%}
  {%- set col = portfolio[pick[0] % portfolio.length] -%}
  {%- set heroes = heroes.concat([col.works[pick[1] % col.works.length]]) -%}
{%- endfor -%}

{#- The hero is deliberately wordless, so the page's heading is for assistive
    tech and search results only. -#}
<h1 class="sr-only">Michael Robinson · Landscape Photography</h1>

<section class="hero" data-hero>
  <div class="hero__sticky">
    <div class="hero__frame" data-hero-frame>
      <div class="hero__stage">
        {#- Only the first slide loads with the page. The others sit behind it
            for 9.5s before the slideshow needs them, so hero.js hydrates their
            data-src/data-srcset after the window load event — that keeps two
            full-viewport images out of the initial payload (matters on 4G). -#}
        {%- for h in heroes %}
        <picture>
          {#- hero.js hydrates the non-first slides after window load, so the
              <source> carries data-srcset alongside the <img>'s. -#}
          <source type="image/avif" data-hero-source sizes="100vw"
                  {% if loop.first %}srcset="{{ h.srcsetAvif }}"{% else %}data-srcset="{{ h.srcsetAvif }}"{% endif %}>
          <img class="hero__slide{% if loop.first %} is-active{% endif %}"
               {% if loop.first %}src="{{ h.display }}" srcset="{{ h.srcset }}" fetchpriority="high"{% else %}data-src="{{ h.display }}" data-srcset="{{ h.srcset }}"{% endif %}
               sizes="100vw" alt="" draggable="false" decoding="async"
               width="{{ h.width }}" height="{{ h.height }}"
               data-hero-slide
               data-cap-left="{{ h.title | upper }}"
               data-cap-right="{{ h.meta | upper }}"
               {% if not loop.first %}style="opacity:0"{% endif %}>
        </picture>
        {%- endfor %}
        <div class="hero__dim" data-hero-dim></div>
      </div>
      <div class="hero__title" data-hero-title>
        <div class="hero__scroll" aria-hidden="true">
          <span class="hero__scroll-word">SCROLL</span>
          <span class="hero__scroll-arrow"></span>
        </div>
      </div>
    </div>
    <div class="hero__cap" data-hero-cap aria-hidden="true">
      <span data-hero-cap-left>{{ heroes[0].title | upper }}</span>
      <span class="hero__cap-right" data-hero-cap-right>{{ heroes[0].meta | upper }}</span>
    </div>
  </div>
</section>

<section class="collections" data-collections>
  <div class="collections__label">COLLECTIONS</div>
  <div class="collections__list">
    {%- for c in portfolio %}
    {#- data-first-* lets transitions.js start downloading the destination's
        first print on touchstart, before the tap even completes. -#}
    <a class="col-row" href="/{{ c.slug }}/" style="--i:{{ loop.index0 }}"
       data-first-src="{{ c.works[0].display }}"
       data-first-srcset="{{ c.works[0].srcset }}"
       data-first-srcset-avif="{{ c.works[0].srcsetAvif }}"
       data-first-sizes="{{ c.works[0].sizes }}">
      <span class="col-row__left">
        {#- Decorative: the collection name is right there in .col-row__name. -#}
        <picture>
          {%- if c.works[0].thumbAvif %}<source type="image/avif" srcset="{{ c.works[0].thumbAvif }}">{% endif %}
          <img class="col-row__thumb" src="{{ c.works[0].thumb }}" alt="" width="64" height="46"
               draggable="false" loading="lazy" decoding="async">
        </picture>
        <span class="col-row__text">
          <span class="col-row__name">{{ c.name }}</span>
          <span class="col-row__note">{{ c.note }}</span>
        </span>
      </span>
      <span class="col-row__count">{{ c.count }} {% if c.count == 1 %}PHOTOGRAPH{% else %}PHOTOGRAPHS{% endif %}</span>
    </a>
    {%- endfor %}
  </div>
</section>
