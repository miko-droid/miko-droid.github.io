---
layout: base.njk
pagination:
  data: portfolio
  size: 1
  alias: collection
permalink: "/{{ collection.slug }}/"
eleventyComputed:
  # `| safe` is load-bearing: without it Nunjucks escapes the "&" in "Dawn &
  # Dusk" here, then base.njk escapes the result again, and the browser tab
  # ends up reading "Dawn &amp; Dusk" literally. Store raw, escape once at use.
  title: "{{ collection.name | safe }}"
  description: "{{ collection.name | safe }} · {{ collection.note | safe }}. Landscape photographs by Michael Robinson."
  # The collection's lead photo is what a shared link should preview.
  ogImage: "{{ collection.works[0].display }}"
---
{%- set total = portfolio | length -%}
{%- set idx = pagination.pageNumber -%}
{%- set prevCol = portfolio[(idx - 1 + total) % total] -%}
{%- set nextCol = portfolio[(idx + 1) % total] -%}

<section class="collection">
  <div class="wrap collection__bar">
    <a class="collection__back" href="/">&larr; ALL COLLECTIONS</a>
    <span>{{ (idx + 1) | roman }} / {{ total | roman }}</span>
  </div>

  <header class="collection__head">
    <div class="collection__count">{{ collection.count }} {% if collection.count == 1 %}PHOTOGRAPH{% else %}PHOTOGRAPHS{% endif %}</div>
    <h1 class="collection__name">{{ collection.name }}</h1>
    <p class="collection__note">{{ collection.intro or collection.note }}</p>
  </header>

  <div class="prints" data-prints>
    {%- for w in collection.works %}
    <figure class="print-block" style="--i:{{ loop.index0 }}">
      <button class="print print--{{ w.o }}" type="button"
              data-print
              data-src="{{ w.full }}"
              data-src-avif="{{ w.fullAvif }}"
              data-display="{{ w.display }}"
              data-title="{{ w.title }}"
              data-meta="{{ w.meta }}"
              data-story="{{ w.story }}"
              aria-label="View photograph: {{ w.title }}{% if w.meta %}, {{ w.meta }}{% endif %}">
        {#- `w.sizes` is emitted per print shape by portfolio.js and is the one
            copy of this string: the warm() prefetch in transitions.js reads it
            off data-first-sizes rather than hardcoding its own. -#}
        <picture>
          {%- if w.srcsetAvif %}<source type="image/avif" srcset="{{ w.srcsetAvif }}" sizes="{{ w.sizes }}">{% endif %}
          <img class="print__img" src="{{ w.display }}" srcset="{{ w.srcset }}"
               sizes="{{ w.sizes }}" decoding="async" style="--ar:{{ w.ratio }}"
               width="{{ w.width }}" height="{{ w.height }}"
               {#- Empty on purpose: the button's aria-label already names the
                   photograph, and the <figcaption> repeats it as visible text.
                   A third copy just makes a screen reader say it three times. -#}
               alt="" draggable="false"
               {#- The second print loads eagerly too — it's the first thing you
                   scroll to, and native lazy starts it late enough on mobile
                   that its pixels pop into an empty mat. -#}
               {% if loop.first %}loading="eager" fetchpriority="high"{% elif loop.index0 == 1 %}loading="eager"{% else %}loading="lazy"{% endif %}>
        </picture>
      </button>
      <figcaption class="cap">
        <span class="cap__left">{{ w.title | upper }}</span>
        {%- if w.meta %}<span class="cap__right">{{ w.meta | upper }}</span>{% endif %}
        {%- if w.story %}<span class="cap__story">{{ w.story }}</span>{% endif %}
      </figcaption>
    </figure>
    {%- endfor %}
  </div>

  <nav class="collection__pager wrap" aria-label="Collections">
    <a class="collection__prev" href="/{{ prevCol.slug }}/">&larr; {{ prevCol.name | upper }}</a>
    <a class="collection__next" href="/{{ nextCol.slug }}/">{{ nextCol.name | upper }} &rarr;</a>
  </nav>
</section>
